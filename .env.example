# Copy to .env.local for local development. Never commit real values.

# Postgres connection string. Required when hosted (for example on Vercel).
# Leave unset on your own machine to use a private SQLite file in .officeproof-data/.
DATABASE_URL=

# Ant Ling key for the optional AI-assisted observations (Ling 3.2 Flash). Server-side only.
# Leave unset to turn the feature off; every check and report works without it.
ANT_LING_API_KEY=
# ANT_LING_MODEL=Ling-3.2-flash
# ANT_LING_BASE_URL=https://api.ant-ling.com/v1

# Where the local SQLite file is kept (default: .officeproof-data).
# OFFICEPROOF_DATA_DIR=
