# Copy to .env.local for local development. Never commit real values.

# Postgres connection string. Required when hosted (for example on Vercel).
# Leave unset on your own machine to use a private SQLite file in .officeproof-data/.
DATABASE_URL=

# Ant Ling key for the optional AI-assisted observations (Ling 3.2 Flash). Server-side only.
# Leave unset to turn the feature off; every check and report works without it.
ANT_LING_API_KEY=
# ANT_LING_MODEL=Ling-3.2-flash
# ANT_LING_BASE_URL=https://api.ant-ling.com/v1

# Univer's browser licence: the contents of license.txt. Optional. With it, decks open with their own design in
# Univer's Pro slide view; without it, slides are drawn from their boxes. Read at build time.
# Never put licenseKey.txt here: that file is a server secret and this app does not use it.
NEXT_PUBLIC_UNIVER_LICENSE=

# Set to off to turn Univer's Office import off; the viewer then uses OfficeProof Lab's own reading of each file.
# OFFICEPROOF_UNIVER_IMPORT=off

# Where the local SQLite file is kept (default: .officeproof-data).
# OFFICEPROOF_DATA_DIR=
